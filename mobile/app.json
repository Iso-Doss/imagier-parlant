{
  "expo": {
    "name": "Imagier parlant",
    "slug": "imagier-parlant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imagierparlant.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.imagierparlant.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-font",
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Le micro sert seulement à savoir si la réponse de l'enfant est juste. La voix n'est ni enregistrée ni envoyée.",
          "speechRecognitionPermission": "La reconnaissance vocale se fait sur le téléphone pour comparer la réponse de l'enfant au nom de l'image. Rien n'est enregistré.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset"
    ],
    "splash": {
      "backgroundColor": "#E7F1FA"
    }
  }
}
